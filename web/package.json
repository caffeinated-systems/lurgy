{
	"name": "web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"check": "biome check --error-on-warnings",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test",
		"gen:api": "uv run --directory ../api python -c \"import json; from app.main import app; print(json.dumps(app.openapi()))\" | openapi-typescript -o src/api/schema.d.ts"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "^1.64.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.13.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
